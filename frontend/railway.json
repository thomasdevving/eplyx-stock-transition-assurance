{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "frontend/Dockerfile",
    "watchPatterns": [
      "/frontend/**",
      "/engine/**",
      "/interface/**",
      "/cloud/Cargo.toml",
      "/cloud/src/**",
      "/programs/eplyx-demo-conversion/**",
      "/reports/**",
      "/snapshots/**",
      "/evidence/**",
      "/probes/**",
      "/scenarios/**",
      "/policies/**",
      "/fixtures/**",
      "/examples/**",
      "/docs/lifecycle-phase-*",
      "/package.json",
      "/package-lock.json",
      "/Cargo.toml",
      "/Cargo.lock",
      "/rust-toolchain.toml",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
