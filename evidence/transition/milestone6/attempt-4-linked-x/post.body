ails:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[80]=[131,138],tag:$R[81]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},"client:VHdlZXQ6MjA2MzYyMzc2ODUzNTM2Mzk0MA==:note_tweet":$R[82]={__id:"client:VHdlZXQ6MjA2MzYyMzc2ODUzNTM2Mzk0MA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[83]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy:$R[84]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy",__typename:"NoteTweetResults",result:$R[85]={__ref:"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy"},"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=":$R[86]={__id:"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=",__typename:"NoteTweet",rest_id:"2063623768392835072",text:"ℹ️ SpaceX PreStocks: What Happens After IPO\n\nSpaceX goes public on June 12.\n\nHere’s what $SPACEX holders can expect:\n\n🔁 After IPO, $SPACEX become convertible into a tokenized public stock equivalent.\n\n🔗 Conversion happens through normal trading and is fully onchain. No KYC required.\n\n✂️ The 5-for-1 stock split will be accounted for.\n\n🔒 Like most private shares, SpaceX has a mandatory post-IPO lockup. In this case, the underlying shares unlock in tranches over the first 6 months.\n\n⏳ During the lockup period: because underlying shares are still locked, liquidity is temporarily limited and $SPACEX trades at a discount to the public stock price. The discount is priced by the market and likely narrows as underlying shares unlock over the 6 months. Holders can sell at this discount and new buyers can buy in at this discount.\n\n🔓 After the lockup period: with underlying shares fully unlocked, $SPACEX converts 1:1 into the tokenized public stock equivalent (before liquidity provider fees), with no lockup discount.\n\n⏰ SpaceX PreStocks ($SPACEX) conversion deadline: 11:59pm UTC on March 12, 2027.\n\n⏰ xAI PreStocks ($XAI) conversion deadline: 11:59pm UTC on September 12, 2026 (conversion into $SPACEX at a 1-to-0.1433 ratio, available since February).\n\n🚨 After these conversion deadlines, these tokens will expire worthless and no longer be supported.",entity_set:$R[87]={__ref:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI="},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set":$R[88]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set",__typename:"EntitySet",hashtags:$R[89]={__refs:$R[90]=[]},symbols:$R[91]={__refs:$R[92]=["client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:3","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:4"]},smarttags:$R[93]={__refs:$R[94]=[]},urls:$R[95]={__refs:$R[96]=[]},timestamps:null,user_mentions:$R[97]={__refs:$R[98]=[]}},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:0":$R[99]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[100]=[89,96],tag:$R[101]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:1":$R[102]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:1",__typename:"ApiTagEntity",indices:$R[103]=[131,138],tag:$R[104]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:2":$R[105]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:2",__typename:"ApiTagEntity",indices:$R[106]=[594,601],tag:$R[107]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:3":$R[108]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:3",__typename:"ApiTag