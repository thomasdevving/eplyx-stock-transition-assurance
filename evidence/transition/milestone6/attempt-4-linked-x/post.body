00]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},U21hcnRUYWc6U1BBQ0VY:$R[201]={__id:"U21hcnRUYWc6U1BBQ0VY",__typename:"SmartTag",info:$R[202]={__ref:"client:U21hcnRUYWc6U1BBQ0VY:info"},id:"U21hcnRUYWc6U1BBQ0VY"},"client:U21hcnRUYWc6U1BBQ0VY:info":$R[203]={__id:"client:U21hcnRUYWc6U1BBQ0VY:info",__typename:"FinanceGetSmartTagInfoResponse",info:null},"client:VHdlZXQ6MjA2MzYyMzc2ODUzNTM2Mzk0MA==:details:cashtag_entities:1":$R[204]={__id:"client:VHdlZXQ6MjA2MzYyMzc2ODUzNTM2Mzk0MA==:details:cashtag_entities:1",__typename:"ApiTagEntity",indices:$R[205]=[131,138],tag:$R[206]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},"client:VHdlZXQ6MjA2MzYyMzc2ODUzNTM2Mzk0MA==:note_tweet":$R[207]={__id:"client:VHdlZXQ6MjA2MzYyMzc2ODUzNTM2Mzk0MA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[208]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy:$R[209]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy",__typename:"NoteTweetResults",result:$R[210]={__ref:"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYzNjIzNzY4MzkyODM1MDcy"},"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=":$R[211]={__id:"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=",__typename:"NoteTweet",rest_id:"2063623768392835072",text:"ℹ️ SpaceX PreStocks: What Happens After IPO\n\nSpaceX goes public on June 12.\n\nHere’s what $SPACEX holders can expect:\n\n🔁 After IPO, $SPACEX become convertible into a tokenized public stock equivalent.\n\n🔗 Conversion happens through normal trading and is fully onchain. No KYC required.\n\n✂️ The 5-for-1 stock split will be accounted for.\n\n🔒 Like most private shares, SpaceX has a mandatory post-IPO lockup. In this case, the underlying shares unlock in tranches over the first 6 months.\n\n⏳ During the lockup period: because underlying shares are still locked, liquidity is temporarily limited and $SPACEX trades at a discount to the public stock price. The discount is priced by the market and likely narrows as underlying shares unlock over the 6 months. Holders can sell at this discount and new buyers can buy in at this discount.\n\n🔓 After the lockup period: with underlying shares fully unlocked, $SPACEX converts 1:1 into the tokenized public stock equivalent (before liquidity provider fees), with no lockup discount.\n\n⏰ SpaceX PreStocks ($SPACEX) conversion deadline: 11:59pm UTC on March 12, 2027.\n\n⏰ xAI PreStocks ($XAI) conversion deadline: 11:59pm UTC on September 12, 2026 (conversion into $SPACEX at a 1-to-0.1433 ratio, available since February).\n\n🚨 After these conversion deadlines, these tokens will expire worthless and no longer be supported.",entity_set:$R[212]={__ref:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI="},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set":$R[213]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set",__typename:"EntitySet",hashtags:$R[214]={__refs:$R[215]=[]},symbols:$R[216]={__refs:$R[217]=["client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:0","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:1","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:2","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:3","client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:4"]},smarttags:$R[218]={__refs:$R[219]=[]},urls:$R[220]={__refs:$R[221]=[]},timestamps:null,user_mentions:$R[222]={__refs:$R[223]=[]}},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:0":$R[224]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:0",__typename:"ApiTagEntity",indices:$R[225]=[89,96],tag:$R[226]={__ref:"U21hcnRUYWc6U1BBQ0VY"},text:"SPACEX"},"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:1":$R[227]={__id:"client:Tm90ZVR3ZWV0OjIwNjM2MjM3NjgzOTI4MzUwNzI=:entity_set:symbols:1",__typename:"ApiTagEntity",indices:$R[228]=[